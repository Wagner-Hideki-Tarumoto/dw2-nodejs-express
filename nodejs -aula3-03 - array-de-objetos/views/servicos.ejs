<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Serviços</title>
</head>
<body>
    <h1>Serviços</h1>
    <hr>
    <h3>Confira Nossos Serviços</h3>
    <!--Exibindo a array de objetos em uma tabela com forEach-->

    <table border="1">
    <tr>
<th>Serviços</th>
<th>Descricão</th>
<th>Preço</th>

    </tr>
    <% servicos.forEach(function(servico){%>
<tr>
<td><%= servico.servico%></td>
<td><%= servico.descricao%></td>
<td><%= servico.preco%></td>
</tr>

    <%})%>
    </table>
</body>
    <p><a href="/"Voltar para a pagina inicial></a></p>
</html>